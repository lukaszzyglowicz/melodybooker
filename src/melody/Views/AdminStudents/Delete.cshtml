@using melody.Models.ViewModels
@model StudentDeleteViewModel
@{
    ViewData["Title"] = "Delete student";
}

<h1>Delete student</h1>

@if (Model.IsBlocked)
{
    <div class="alert alert-warning">
        <p><strong>@Model.FullName</strong> cannot be deleted because they still have active reservations:</p>
        <ul>
            @foreach (var reservation in Model.Reservations)
            {
                <li>@reservation.RoomName &mdash; @reservation.DayOfWeek @reservation.StartTime.ToString(@"hh\:mm")-@reservation.EndTime.ToString(@"hh\:mm")</li>
            }
        </ul>
        <p>Cancel these reservations before deleting this student.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
}
else
{
    <h3>Are you sure you want to delete this student?</h3>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-10">@Model.FullName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
}
