@using melody.Models.ViewModels
@model List<TeacherListItemViewModel>
@{
    ViewData["Title"] = "Teachers";
}

<h1>Teachers</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Add teacher</a>
</p>

@if (!Model.Any())
{
    <p>No teachers yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().FullName)</th>
                <th>Email</th>
                <th>@Html.DisplayNameFor(m => m.First().StudentCount)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var teacher in Model)
            {
                <tr>
                    <td>@teacher.FullName</td>
                    <td>@teacher.Email</td>
                    <td>@teacher.StudentCount</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@teacher.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@teacher.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p>
    <a asp-controller="Admin" asp-action="Index">Back to dashboard</a>
</p>
