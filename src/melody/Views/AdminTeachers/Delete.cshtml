@using melody.Models.ViewModels
@model TeacherDeleteViewModel
@{
    ViewData["Title"] = "Delete teacher";
}

<h1>Delete teacher</h1>

@if (Model.IsBlocked)
{
    <div class="alert alert-warning">
        <p><strong>@Model.FullName</strong> cannot be deleted because the following students are still assigned to them:</p>
        <ul>
            @foreach (var studentName in Model.AssignedStudentNames)
            {
                <li>@studentName</li>
            }
        </ul>
        <p>Reassign these students to another teacher before deleting this teacher.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
}
else
{
    <h3>Are you sure you want to delete this teacher?</h3>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-10">@Model.FullName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
}
